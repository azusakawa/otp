{
  "compilerOptions": {
    "target": "ES2022", "lib": ["ES2022","DOM","DOM.Iterable"],
    "module": "ESNext", "moduleResolution": "bundler",
    "jsx": "react-jsx", "strict": true, "esModuleInterop": true,
    "outDir": "./dist", "rootDir": "./", "skipLibCheck": true,
    "resolveJsonModule": true, "baseUrl": ".",
    "paths": { "@/*": ["./src/*"] }
  },
  "include": ["src", "electron", "vite.config.ts"]
}
